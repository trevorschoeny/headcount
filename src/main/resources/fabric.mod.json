{
  "schemaVersion": 1,
  "id": "headcount",
  "version": "${version}",
  "name": "Headcount",
  "description": "See how many entities are crammed into a block, scroll through the crammed entities to pick one, and keep counts of the entities around you on the HUD.",
  "authors": [
    "trevorschoeny"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/headcount",
    "sources": "https://github.com/trevorschoeny/headcount"
  },
  "license": "MIT",
  "environment": "*",
  "mixins": [
    "headcount.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "com.trevorschoeny.headcount.Headcount"
    ],
    "client": [
      "com.trevorschoeny.headcount.HeadcountClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "menukit": ">=7.3.0 <8.0.0"
  }
}
